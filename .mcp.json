{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "vuetify-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "@vuetify/mcp"
            ]
        },
        "nightwatch": {
            "type": "http",
            "url": "https://nightwatch.laravel.com/mcp"
        }
    }
}
