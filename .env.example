# ==============================================================================
# Find Mass - Environment Configuration
# ==============================================================================
# This file contains all available environment variables.
# Copy to .env and configure for your environment.
#
# For Coolify deployment, see: docs/COOLIFY_DEPLOYMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
LARAVEL_CLOUDFLARE_ENABLED=false

POSTHOG_ENABLED=false
POSTHOG_KEY=
VITE_POSTHOG_KEY=

# ------------------------------------------------------------------------------
# Backup Configuration (spatie/laravel-backup)
# ------------------------------------------------------------------------------
BACKUP_FOLDER_ROOT=
BACKUP_FOLDER=
BACKUP_MAIL_TO=
BACKUP_SLACK_URL=
BACKUP_SLACK_CHANNEL=
BACKUP_SLACK_USERNAME=
BACKUP_SLACK_ICON=

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Choose ONE database connection type below.

# ------------------------------------------------------------------------------
# Option 1: SQLite (Local Development - Default)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
# Database file will be created at: database/database.sqlite

# ------------------------------------------------------------------------------
# Option 2: PostgreSQL (Production / Coolify Deployment)
# ------------------------------------------------------------------------------
# Uncomment and configure for production deployment:
#
# DB_CONNECTION=pgsql
# DB_HOST=findmass-postgres          # Coolify internal hostname
# DB_PORT=5432
# DB_DATABASE=find_mass
# DB_USERNAME=find_mass
# DB_PASSWORD=your-secure-password

# ------------------------------------------------------------------------------
# Option 3: MySQL/MariaDB
# ------------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=find_mass
# DB_USERNAME=root
# DB_PASSWORD=

# ==============================================================================
# CACHE, QUEUE & SESSION
# ==============================================================================

# ------------------------------------------------------------------------------
# Local Development (uses database)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ------------------------------------------------------------------------------
# Production with Redis (Recommended for Coolify)
# ------------------------------------------------------------------------------
# Uncomment for production:
#
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=database           # Keep sessions in DB for persistence
#
# REDIS_HOST=findmass-redis         # Coolify internal hostname
# REDIS_PORT=6379
# REDIS_PASSWORD=null               # Set if Redis has authentication
# REDIS_CLIENT=phpredis

# ------------------------------------------------------------------------------
# Redis Settings (for local development with Redis)
# ------------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# MAIL CONFIGURATION
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Production Mail (SMTP Example)
# ------------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your-username
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@your-domain.com
# MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# AWS / S3 Storage (Optional)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# Frontend / Vite
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_API_KEY=
VITE_POSTHOG_ENABLED=false
