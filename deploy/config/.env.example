# =============================================================================
# Deployment Configuration
# =============================================================================
# Copy this file to the project root as:
#   - .env.deploy           (default — used when --env is not specified)
#   - .env.deploy.staging   (used with --env staging)
#   - .env.deploy.production (used with --env production)
#
# Then run: ./deploy/scripts/deploy.sh [--env staging|production]
#
# This file contains three categories of variables:
#
#   1. DEPLOYMENT VARIABLES
#      Used by the deploy scripts only. Never passed to the container.
#
#   2. APPLICATION VARIABLES (Runtime)
#      Passed to the container via --env-file at runtime. Safe for secrets.
#      No need to edit the deploy scripts when adding new vars — just add
#      them here and they will be picked up on the next deployment.
#
#   3. FRONTEND VARIABLES (Build-Time)
#      VITE_* prefixed. Baked into the JavaScript bundle during docker build.
#      NOT safe for secrets — visible in page source and Docker image layers.
#      Each VITE_* var must have a matching ARG in the Dockerfile.
#
# The persistent env file on the server uses safe merging:
#   - New variables are added
#   - Changed values are updated
#   - Variables removed from this file are KEPT on the server (never deleted)
#     to prevent accidental breakage
#
# FRESH_DB and SEED_DB are controlled via CLI flags (--fresh-db, --seed)
# and are not part of this file.
# =============================================================================


# =============================================================================
# 1. DEPLOYMENT VARIABLES
# =============================================================================
# Used by the deploy scripts only. These are NOT passed to the container.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Connection
# -----------------------------------------------------------------------------
# SSH connection details for the deployment server
SERVER_USER=ubuntu
SERVER_HOST=your-server-ip
SERVER_PORT=22
SERVER_DEPLOY_PATH=/opt/deployments

# SSH key path (optional)
# If not set, uses your default SSH key (~/.ssh/id_rsa or id_ed25519)
# Useful when you have a dedicated deploy key for each environment
# Examples:
#   SSH_KEY_PATH=~/.ssh/id_ed25519
#   SSH_KEY_PATH=~/.ssh/deploy_staging_key
#   SSH_KEY_PATH=~/.ssh/deploy_production_key
SSH_KEY_PATH=

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Domain is used for:
#   - Naming Docker resources (containers, networks, images)
#   - Nginx server configuration
#   - SSL certificate requests
#
# Examples:
#   - Staging: staging.example.com
#   - Production: example.com
DOMAIN=example.com

# -----------------------------------------------------------------------------
# Docker Container
# -----------------------------------------------------------------------------
# Container user name (must match the non-root user created in your Dockerfile)
# Update this to match whatever user your Dockerfile creates (e.g., app, sail, laravel)
# The deploy scripts use this for documentation and volume ownership context.
# The UID/GID used for chown operations defaults to 1337 — ensure your Dockerfile
# creates the user with the same UID.
CONTAINER_USER=app

# -----------------------------------------------------------------------------
# Deployment Options
# -----------------------------------------------------------------------------
# Health check settings
HEALTH_CHECK_TIMEOUT=60
HEALTH_CHECK_INTERVAL=2

# Number of old Docker images to keep on server
KEEP_OLD_IMAGES=3

# Container ports (do not change unless you know what you're doing)
BLUE_PORT=8080
GREEN_PORT=8081


# =============================================================================
# 2. APPLICATION VARIABLES (Runtime)
# =============================================================================
# Passed to the container via --env-file at runtime. These are safe for secrets
# — they are never baked into the Docker image.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="My App"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Generate with: php artisan key:generate --show
APP_KEY=base64:your-key-here

# Full URL including protocol (will be https:// after SSL setup)
APP_URL=https://example.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Database connection driver (sqlite, mysql, pgsql)
DB_CONNECTION=sqlite

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis is installed directly on the host server.
# Containers access it via host.docker.internal
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=null

# Redis client library (phpredis or predis)
REDIS_CLIENT=phpredis

# -----------------------------------------------------------------------------
# Cache, Queue & Session
# -----------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Broadcasting
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Mail Configuration
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# AWS S3 (optional - for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=


# =============================================================================
# 3. FRONTEND VARIABLES (Build-Time)
# =============================================================================
# Variables prefixed with VITE_* are baked into the JavaScript bundle during
# Docker build. They are NOT runtime variables — changing them requires a
# rebuild and redeploy.
#
# The deploy script automatically passes all VITE_* vars as --build-arg flags.
# Each VITE_* var must also have a matching ARG in the Dockerfile.
#
# IMPORTANT: Do not use VITE_* for secrets or sensitive data. These values are
# embedded in the frontend bundle (visible in page source) and stored in Docker
# image layers. Use regular (non-VITE_*) env vars for secrets — they are passed
# to the container at runtime via --env-file and never baked into the image.
#
# See "Frontend Environment Variables" in deploy/README.md for details.
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
