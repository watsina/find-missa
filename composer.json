{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.10.0",
    "jenssegers/agent": "^2.6.4",
    "laravel/breeze": "^2.4.1",
    "laravel/fortify": "^1.36.1",
    "laravel/framework": "^12.54.1",
    "laravel/nightwatch": "^1.24.3",
    "laravel/pail": "^1.2.6",
    "laravel/pennant": "^1.21",
    "laravel/pulse": "^1.7.0",
    "laravel/sanctum": "^4.3.1",
    "laravel/scout": "^10.25.0",
    "laravel/slack-notification-channel": "^3.7",
    "laravel/tinker": "^2.11.1",
    "league/flysystem-aws-s3-v3": "^3.32.0",
    "maatwebsite/excel": "^3.1.67",
    "opcodesio/log-viewer": "^3.23.0",
    "posthog/posthog-php": "^3.7.3",
    "spatie/laravel-backup": "^9.4.1",
    "spatie/laravel-permission": "^6.24.1",
    "tightenco/ziggy": "^1.8.2"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.16.5",
    "fakerphp/faker": "^1.24.1",
    "jasonmccreary/laravel-test-assertions": "^2.8",
    "laravel-shift/blueprint": "^2.13.0",
    "laravel/boost": "^2.3.1",
    "laravel/pint": "^1.29.0",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.1",
    "pestphp/pest": "^3.8.6",
    "pestphp/pest-plugin-faker": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.2",
    "spatie/laravel-ignition": "^2.11.0"
  },
  "autoload": {
    "files": [
      "app/helpers.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": "php artisan config:clear && vendor/bin/pest --colors=always --testdox --stop-on-failure",
    "lint": "./vendor/bin/pint -v --test",
    "lint:fix": "./vendor/bin/pint -v",
    "check-phpstan": "phpstan analyse --memory-limit=2G",
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail -v --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
