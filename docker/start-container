#!/usr/bin/env bash

set -e

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "findMissa" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'findMissa' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER findMissa
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Run Laravel setup commands BEFORE exec (which replaces the process)
if [ $# -eq 0 ]; then
    echo "Running Laravel setup commands..."

    # ===========================================================================
    # SQLite Database Setup
    # ===========================================================================
    SQLITE_DB="/var/www/html/database/database.sqlite"

    # The SQLite file is mounted from the host. The database/ directory exists
    # in the image and contains migrations, factories, and seeders.
    echo "Setting up SQLite database..."

    # Ensure the mounted SQLite file has correct permissions
    if [ -f "$SQLITE_DB" ]; then
        chown findMissa:findMissa "$SQLITE_DB"
        chmod 664 "$SQLITE_DB"
    fi

    # Ensure WAL files have correct ownership if they exist
    if [ -f "${SQLITE_DB}-wal" ]; then
        chown findMissa:findMissa "${SQLITE_DB}-wal"
        chmod 664 "${SQLITE_DB}-wal"
    fi
    if [ -f "${SQLITE_DB}-shm" ]; then
        chown findMissa:findMissa "${SQLITE_DB}-shm"
        chmod 664 "${SQLITE_DB}-shm"
    fi

    # ===========================================================================
    # Storage Directory Setup
    # ===========================================================================
    echo "Creating storage directories..."
    mkdir -p /var/www/html/storage/framework/{sessions,views,cache}
    mkdir -p /var/www/html/storage/logs
    mkdir -p /var/www/html/storage/app/public

    # Create storage symlink if it doesn't exist
    # This links public/storage -> storage/app/public for serving uploaded files
    if [ ! -L /var/www/html/public/storage ]; then
        echo "Creating storage symlink..."
        php artisan storage:link --ansi
    fi

    # ===========================================================================
    # Laravel Optimization
    # ===========================================================================
    php artisan package:discover --ansi

    # Optimize application (caches config, events, routes, and views)
    php artisan optimize --ansi

    # ===========================================================================
    # Database Migration
    # ===========================================================================
    echo "Running database migrations..."
    php artisan migrate --force --ansi

    # ===========================================================================
    # ACL Permissions Seeding
    # ===========================================================================
    # Always seed permissions so new ones from config are available immediately.
    # Uses firstOrCreate internally, so it's safe to run on every deployment.
    echo "Seeding ACL permissions..."
    php artisan db:seed --class=AclSeeder --force --ansi

    # ===========================================================================
    # Holiday Seeding
    # ===========================================================================
    # Seed universal Catholic holidays so the scheduling engine and schedule
    # period generation can reference them. Uses updateOrCreate keyed on slug,
    # so it's safe to run on every deployment.
    echo "Seeding holidays..."
    php artisan db:seed --class=HolidaySeeder --force --ansi

    # ===========================================================================
    # Schedule Period Generation
    # ===========================================================================
    # Generate liturgical schedule periods for current and next year.
    # Skips existing periods by default (no --force), so it's safe to run
    # on every deployment without overwriting user customizations.
    echo "Generating schedule periods..."
    php artisan schedule-periods:generate --ansi

    # ===========================================================================
    # Queue Management
    # ===========================================================================
    # Note: queue:restart may fail if Redis is unavailable, but this shouldn't
    # prevent the container from starting. The queue worker will pick up jobs
    # once Redis becomes available.
    php artisan queue:restart --ansi || echo "Warning: queue:restart failed (Redis may be unavailable)"
fi

# Ensure storage directory has correct permissions
# This runs AFTER artisan commands to fix any files they created
echo "Setting storage permissions..."
chown -R findMissa:findMissa /var/www/html/storage
chmod -R 775 /var/www/html/storage

# Ensure SQLite database file permissions are correct
if [ -f /var/www/html/database/database.sqlite ]; then
    chown findMissa:findMissa /var/www/html/database/database.sqlite
    chmod 664 /var/www/html/database/database.sqlite
fi

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
